{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fileguard.local/schemas/scanner-result.schema.json",
  "title": "FileGuard Scanner Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scanner", "scanner_version", "status", "sample_sha256", "detected", "findings", "artifacts", "metadata"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "scanner": {"enum": ["clamav", "yara", "capa", "office-analysis", "pdf-analysis"]},
    "scanner_version": {"type": "string", "minLength": 1},
    "ruleset_version": {"type": "string", "minLength": 1},
    "status": {"enum": ["complete", "partial", "error", "skipped", "timeout"]},
    "sample_sha256": {"$ref": "#/$defs/sha256"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "duration_ms": {"type": "integer", "minimum": 0},
    "detected": {"type": ["boolean", "null"], "description": "Null means no reliable detection result was reached."},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "metadata": {"type": "object", "description": "Scanner-specific structured metadata.", "additionalProperties": true},
    "error": {"$ref": "#/$defs/error"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"enum": ["error", "timeout"]}}, "required": ["status"]}, "then": {"required": ["error"], "properties": {"detected": {"type": "null"}}}},
    {"if": {"properties": {"status": {"const": "complete"}}, "required": ["status"]}, "then": {"properties": {"detected": {"type": "boolean"}}}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "severity", "confidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "severity": {"enum": ["informational", "low", "medium", "high", "critical"]},
        "confidence": {"type": "integer", "minimum": 0, "maximum": 100},
        "evidence": {"type": "object", "additionalProperties": true},
        "tags": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "media_type": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 0},
        "storage_reference": {"type": "string", "minLength": 1, "description": "Opaque artifact storage reference."}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "retryable": {"type": "boolean"}
      }
    }
  }
}
