{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fileguard.local/schemas/verdict.schema.json",
  "title": "FileGuard Verdict",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sample_sha256", "scoring_engine_version", "policy_version", "status", "score", "verdict", "action", "reasons", "scanner_results"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "sample_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "scoring_engine_version": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "status": {"enum": ["complete", "incomplete", "error"]},
    "score": {"type": "integer", "minimum": 0, "maximum": 100},
    "verdict": {"enum": ["clean", "review", "malicious"]},
    "action": {"enum": ["release", "hold", "quarantine"]},
    "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "scanner_results": {"type": "array", "items": {"$ref": "#/$defs/scannerSummary"}, "minItems": 1},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"verdict": {"const": "clean"}}, "required": ["verdict"]}, "then": {"properties": {"action": {"const": "release"}, "status": {"const": "complete"}}}},
    {"if": {"properties": {"verdict": {"const": "review"}}, "required": ["verdict"]}, "then": {"properties": {"action": {"const": "hold"}}}},
    {"if": {"properties": {"verdict": {"const": "malicious"}}, "required": ["verdict"]}, "then": {"properties": {"action": {"const": "quarantine"}}}}
  ],
  "$defs": {
    "scannerSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scanner", "status", "detected", "finding_count"],
      "properties": {
        "scanner": {"enum": ["classifier", "clamav", "yara", "capa", "office-analysis", "pdf-analysis"]},
        "status": {"enum": ["complete", "partial", "error", "skipped", "timeout"]},
        "detected": {"type": ["boolean", "null"]},
        "finding_count": {"type": "integer", "minimum": 0},
        "result_reference": {"type": "string", "minLength": 1, "description": "Opaque reference to the complete scanner result."}
      }
    }
  }
}
